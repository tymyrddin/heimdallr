# Example environment. Copy to .env and edit:  cp env.sample .env
#
# .env (gitignored) is the single source of truth. ctl never generates or
# refreshes it. The indexer admin hash is derived from INDEXER_PASSWORD at
# `ctl up`, so the plaintext here and the hash the indexer enforces cannot
# drift. To change the password on a running range, use `./ctl set-password`.
# The default below is fine for a local range that is never exposed.

# Wazuh indexer admin password (user: admin).
INDEXER_PASSWORD=SecretPassword

# Wazuh manager API account.
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=MyS3cr37P450r.*-
