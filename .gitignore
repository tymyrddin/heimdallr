# Local credentials / env. OpenSearch runs security-disabled on the local node, so
# none is required; this just makes sure an operator's local .env is never committed.
.env

# ingest/ is tracked: the bundle directories (raw telemetry, and an optional brief
# alongside) ship with the lab, so a fresh clone runs the scenarios out of the box.

# Sensor scratch
*.pcap.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store
